FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements-dbt.txt /app/requirements-dbt.txt
RUN pip install --no-cache-dir -r /app/requirements-dbt.txt

COPY dbt_wadiz /app/dbt_wadiz
# profiles.yml.example은 값을 환경변수(env_var)로 읽으므로 그대로 복사해 사용한다.
RUN cp /app/dbt_wadiz/profiles.yml.example /app/dbt_wadiz/profiles.yml

# ECS containerOverrides로 command를 주입한다. 기본은 dbt build.
CMD ["dbt", "build", "--project-dir", "/app/dbt_wadiz", "--profiles-dir", "/app/dbt_wadiz"]
