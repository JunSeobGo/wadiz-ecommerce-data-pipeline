# dbt-athena 연결 프로필 예시.
# 실제 값(버킷/DB/리전)은 환경변수로 주입하거나 이 파일을 profiles.yml로 복사해 채운다.
# ECS 컨테이너 실행 시에는 환경변수(WADIZ_*)로 주입한다.
wadiz:
  target: dev
  outputs:
    dev:
      type: athena
      # Athena 쿼리 결과 저장 위치
      s3_staging_dir: "{{ env_var('DBT_ATHENA_S3_STAGING_DIR', 's3://example-athena-results/dbt/') }}"
      # dbt가 만든 Gold 테이블의 데이터가 저장될 위치
      s3_data_dir: "{{ env_var('DBT_ATHENA_S3_DATA_DIR', 's3://example-data-lake/gold_dbt/') }}"
      region_name: "{{ env_var('AWS_REGION', 'ap-northeast-2') }}"
      database: awsdatacatalog
      # Gold 결과가 생성될 Glue 데이터베이스
      schema: "{{ env_var('WADIZ_GOLD_DB', 'wadiz_gold2_db') }}"
      work_group: "{{ env_var('DBT_ATHENA_WORKGROUP', 'primary') }}"
      threads: 4
